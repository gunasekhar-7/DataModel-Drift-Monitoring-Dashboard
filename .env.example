# Environment configuration for Data & Model Drift Monitoring Platform

# Application
APP_NAME=data-drift-monitoring
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drift_monitoring

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_DEFAULT_ALLOW_UNREGISTERED_PARAMS=True

# Redis (optional, for RQ/celery)
REDIS_URL=redis://localhost:6379/0

# External services
SLACK_WEBHOOK_URL=http://localhost:8000/api/notifications/slack/-webhook
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password

# Model artifacts
MODEL_ARTIFACT_PATH=artifacts/model.pkl
PREPROCESSOR_ARTIFACT_PATH=artifacts/preprocessor.pkl
FEATURE_SCHEMA_PATH=artifacts/features.json

# Security
SECRET_KEY=your-secret-key-change-this-in-production